# Copy this file to .env and replace only the values needed by an explicit
# ENTSO-E or RTE acquisition operation, or by an explicitly selected licensed
# solver workflow. Package imports and offline workflows never load this file.
# The real .env remains ignored and must never be committed.
ENTSOE_API_TOKEN=replace-with-your-entsoe-api-token
RTE_CLIENT_ID=replace-with-your-rte-client-id
RTE_CLIENT_SECRET=replace-with-your-rte-client-secret
GRB_LICENSE_FILE=replace-with-your-gurobi-license-file-path
